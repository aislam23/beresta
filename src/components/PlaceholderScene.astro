---
interface Props { uid: string }
const { uid } = Astro.props;
---
<svg viewBox="0 0 1100 300" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
  <defs>
    <g id={`${uid}-pines`}>
      <path d="M0 300 L0 210 L18 170 L10 172 L26 130 L18 132 L34 92 L50 132 L42 130 L58 172 L50 170 L68 210 L68 300Z"/>
      <path d="M60 300 L60 200 L80 150 L72 152 L90 104 L82 106 L100 60 L118 106 L110 104 L128 152 L120 150 L140 200 L140 300Z"/>
      <path d="M130 300 L130 220 L146 186 L139 188 L153 150 L146 152 L160 118 L174 152 L167 150 L181 188 L174 186 L190 220 L190 300Z"/>
      <path d="M840 300 L840 196 L860 150 L852 152 L870 104 L862 106 L880 58 L898 106 L890 104 L908 152 L900 150 L920 196 L920 300Z"/>
      <path d="M905 300 L905 214 L922 176 L915 178 L930 138 L923 140 L938 100 L953 140 L946 138 L961 178 L954 176 L971 214 L971 300Z"/>
      <path d="M960 300 L960 190 L982 140 L973 142 L993 90 L984 92 L1004 40 L1024 92 L1015 90 L1035 142 L1026 140 L1048 190 L1048 300Z"/>
    </g>
    <g id={`${uid}-towers`}>
      <rect x="0" y="125" width="120" height="135" rx="2"/>
      <rect x="135" y="80" width="120" height="180" rx="2"/>
      <rect x="270" y="50" width="130" height="210" rx="2"/>
    </g>
    <pattern id={`${uid}-win`} width="15" height="15" patternUnits="userSpaceOnUse"><rect x="3" y="4" width="9" height="8" fill="#B5AE9E"/></pattern>
    <g id={`${uid}-scene`}>
      <g transform="translate(520,40)"><use href={`#${uid}-towers`} fill="#ECE6DA"/><g fill={`url(#${uid}-win)`} opacity=".7"><rect x="8" y="135" width="104" height="120"/><rect x="143" y="90" width="104" height="165"/><rect x="278" y="60" width="114" height="195"/></g></g>
      <g fill="#7E8C7C" opacity=".5" transform="translate(0,10)"><use href={`#${uid}-pines`}/></g>
      <g fill="#3F5444" transform="translate(-40,40) scale(1.08)"><use href={`#${uid}-pines`}/></g>
    </g>
  </defs>
  <use href={`#${uid}-scene`}/>
</svg>
<style>
  svg { position: absolute; left: 0; bottom: 0; width: 100%; height: 78%; }
</style>
