---
import type { YardIconName } from '../data/yard';
interface Props { name: YardIconName }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'parking' && (<><rect x="4" y="3" width="16" height="18" rx="3"/><path d="M10 16V8h3a2.5 2.5 0 0 1 0 5h-3"/></>)}
  {name === 'playground' && (<><path d="M4 21V9l8-5 8 5v12"/><path d="M9 21v-6h6v6"/><path d="M4 13h16"/></>)}
  {name === 'lobby' && (<><path d="M5 21V4h14v17"/><path d="M3 21h18"/><path d="M14 12h.01"/></>)}
  {name === 'storage' && (<><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 12h18"/><path d="M10 8h4M10 16h4"/></>)}
</svg>
