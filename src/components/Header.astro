---
import Logo from './Logo.astro';
import { nav, complex } from '../data/complex';
---
<header class="hdr">
  <div class="wrap">
    <Logo />
    <nav class="nav" aria-label="Разделы">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <div class="hdr-r">
      <a class="tel" href={complex.phone.href}>{complex.phone.display}</a>
      <a class="btn btn-p" href="#pick">Подобрать квартиру</a>
    </div>
  </div>
</header>
<style>
  .hdr { position: sticky; top: 0; z-index: 40; background: rgba(244, 239, 230, .86); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .hdr .wrap { display: flex; align-items: center; justify-content: space-between; height: calc(var(--hdr-h) - 1px); gap: 24px; }
  .nav { display: flex; gap: 26px; font-size: 14px; font-weight: 600; }
  .nav a { text-decoration: none; color: var(--ink-2); } .nav a:hover { color: var(--ink); }
  .hdr-r { display: flex; align-items: center; gap: 18px; font-size: 14px; font-weight: 700; }
  .hdr-r .tel { text-decoration: none; }
  .hdr .btn { padding: 12px 16px; font-size: 14px; }
  @media (max-width: 980px) { .nav { display: none; } }
  @media (max-width: 640px) { .hdr-r .tel { display: none; } }
</style>
