---
import Photo from './Photo.astro';
import NumCard from './NumCard.astro';
import { heroNums } from '../data/complex';
---
<section id="hero" class="hero" aria-labelledby="hero-title">
  <Photo
    class="hero-photo"
    shot="01-hero"
    alt="Три корпуса «Бересты» над соснами в утреннем тумане"
    placeholder="Кадр 01 · эталон: три корпуса 9/12/14 этажей над соснами, туман с реки"
    sizes="100vw"
    eager
  />
  <div class="fog" aria-hidden="true"></div>
  <div class="wrap">
    <div class="hero-card">
      <h1 id="hero-title">Город за спиной, <span>лес за&nbsp;окном</span></h1>
      <p class="lead">Три дома у соснового бора и реки, в 15&nbsp;минутах от центра Казани. Машины стоят в подземном паркинге, во двор они не заезжают.</p>
      <div class="cta">
        <a class="btn btn-p" href="#pick">Подобрать 3–5&nbsp;вариантов</a>
        <a class="btn btn-s" href="#flats">Планировки и цены</a>
      </div>
      <p class="note">Менеджер соберёт варианты под ваш бюджет и ипотеку. Консультация занимает 30&nbsp;минут.</p>
    </div>
    <div class="nums">
      {heroNums.map((n) => <NumCard num={n} />)}
    </div>
  </div>
</section>
<style>
  .hero { position: relative; overflow: hidden; padding: 0; scroll-margin-top: var(--hdr-h); min-height: max(640px, calc(100svh - var(--hdr-h))); display: flex; flex-direction: column; justify-content: flex-end; }
  .hero :global(.hero-photo) { position: absolute; inset: 0; border-radius: 0; min-height: 0; }
  .hero :global(.hero-photo.tone-mist .ph) { background:
      radial-gradient(120% 70% at 72% 25%, #FBF4E6 0%, rgba(251, 244, 230, 0) 60%),
      linear-gradient(180deg, #E9E4D8 0%, #DCD9CC 45%, #C9CDC0 70%, #AEB6A8 100%); }
  .hero :global(.hero-photo[data-shot])::after { top: auto; bottom: 150px; }
  .hero :global(.hero-photo svg) { height: 70%; }
  .fog { position: absolute; left: -10%; right: -10%; bottom: 24%; height: 26%; background: linear-gradient(180deg, rgba(244, 239, 230, 0), rgba(244, 239, 230, .85) 50%, rgba(244, 239, 230, 0)); filter: blur(8px); pointer-events: none; }
  .hero .wrap { position: relative; width: 100%; padding-top: 48px; padding-bottom: 28px; }
  .hero-card { background: rgba(251, 248, 242, .94); backdrop-filter: blur(8px); border-radius: 24px; padding: clamp(24px, 3.4vw, 44px); max-width: 720px; margin-bottom: 12px; box-shadow: 0 20px 50px -30px rgba(38, 40, 43, .35); }
  .hero h1 { font-size: clamp(40px, 6vw, 80px); letter-spacing: -.05em; line-height: .95; margin: 0; }
  .hero h1 span { color: var(--pine); }
  .hero .lead { margin-top: 18px; }
  .hero .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .hero .note { font-size: 13px; color: var(--ink-2); margin-top: 12px; }
  .nums { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  @media (max-width: 980px) {
    .nums { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .hero { min-height: auto; padding-top: 300px; }
    .hero :global(.hero-photo) { bottom: auto; height: 420px; }
    .hero-card { border-radius: 20px; }
  }
</style>
