---
import { Picture } from 'astro:assets';
import { getShot } from '../assets/photos';
import { places, home } from '../data/area';

const img = getShot('08-area-map');
const W = 1536;
const H = 1024;
const fmt = (p: { value?: string; unit?: string }) => (p.value ? `${p.value} ${p.unit}` : '');

/** Маршрут от домов до места: дуга, выгнутая вбок на седьмую часть длины, чтобы линия не лежала на улице. */
function route(x: number, y: number) {
  const [x0, y0, x1, y1] = [(home.x * W) / 100, (home.y * H) / 100, (x * W) / 100, (y * H) / 100];
  const [dx, dy] = [x1 - x0, y1 - y0];
  const [cx, cy] = [(x0 + x1) / 2 - dy / 7, (y0 + y1) / 2 + dx / 7];
  return `M${x0.toFixed(0)} ${y0.toFixed(0)} Q${cx.toFixed(0)} ${cy.toFixed(0)} ${x1.toFixed(0)} ${y1.toFixed(0)}`;
}

/** С какой стороны от точки открывать подсказку, чтобы она не вылезала за край карты. */
const side = (x: number, y: number) => [x > 66 ? 'tip-l' : x < 34 ? 'tip-r' : 'tip-c', y < 26 ? 'tip-b' : 'tip-t'];
const first = places[0].id;
---
<div class="amap" data-amap data-active={first} style={`--x: ${places[0].x}%; --y: ${places[0].y}%`}>
  <div class="view">
    {img ? (
      <Picture src={img} widths={[640, 960, 1280, 1536]} sizes="(max-width: 980px) 100vw, 780px" formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" alt="Вид сверху на район: слева сосновый бор, внизу река с набережной, справа школа, детские сады, ТЦ и проспект к метро" />
    ) : (
      <div class="ph" role="img" aria-label="Карта района"></div>
    )}
    <div class="dim" aria-hidden="true"></div>
    <svg class="routes" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
      {places.map((p) => <path class:list={['route', { on: p.id === first }]} data-id={p.id} d={route(p.x, p.y)} pathLength="1" />)}
    </svg>
    <div class="home" style={`left: ${home.x}%; top: ${home.y}%`} aria-hidden="true"><span>ЖК «Береста»</span></div>
    {places.map((p) => (
      <button type="button" class:list={['pin', ...side(p.x, p.y), { on: p.id === first }]} data-id={p.id} data-x={p.x} data-y={p.y} style={`left: ${p.x}%; top: ${p.y}%`} tabindex="-1" aria-hidden="true">
        <span class="dot"></span>
        <span class="tip"><b>{p.title}{p.value && <span class="tip-v">{fmt(p)}</span>}</b><span>{p.text}</span></span>
      </button>
    ))}
  </div>
  <div class="side">
    <ul class="list">
      {places.map((p) => (
        <li>
          <button type="button" class:list={['place', { on: p.id === first }]} data-id={p.id} aria-pressed={p.id === first ? 'true' : 'false'}>
            <span class="v">{p.value ? <>{p.value}<small>{p.unit}</small></> : <i class="v-dot" aria-hidden="true"></i>}</span>
            <span class="t"><strong>{p.title}</strong><span class="note">{p.text}</span></span>
          </button>
        </li>
      ))}
    </ul>
  </div>
</div>
<style>
  .amap { display: grid; grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr); gap: clamp(16px, 2vw, 28px); align-items: start; }
  .view { position: relative; aspect-ratio: 3 / 2; border-radius: var(--r); overflow: hidden; background: var(--pine-2); border: 1px solid var(--line); }
  .view :global(picture), .view :global(img), .ph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* Всё, кроме выбранного места, чуть уходит в туман: светлое пятно стоит на точке */
  .dim { position: absolute; inset: 0; pointer-events: none; background: rgba(244, 239, 230, .3);
    -webkit-mask: radial-gradient(circle at var(--x) var(--y), transparent 0 9%, #000 20%);
    mask: radial-gradient(circle at var(--x) var(--y), transparent 0 9%, #000 20%);
    transition: opacity .3s; }

  .routes { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  .route { fill: none; stroke: var(--copper-strong); stroke-width: 4; stroke-linecap: round; vector-effect: non-scaling-stroke;
    stroke-dasharray: 1; stroke-dashoffset: 1; filter: drop-shadow(0 0 2px #fff) drop-shadow(0 0 1px #fff); transition: stroke-dashoffset .6s cubic-bezier(.3, .7, .2, 1); }
  .route.on { stroke-dashoffset: 0; }

  .home, .pin { position: absolute; translate: -50% -50%; }
  .home { width: 18px; height: 18px; border-radius: 50%; background: var(--ink); border: 3px solid #fff; box-shadow: 0 2px 8px rgba(0, 0, 0, .3); }
  .home span { position: absolute; left: 50%; top: calc(100% + 6px); translate: -50% 0; white-space: nowrap; font-size: 13px; font-weight: 800; background: var(--ink); color: #fff; padding: 4px 8px; border-radius: 8px; }

  /* Точка: кольцо крупнее, чем видно, чтобы в неё легко попасть пальцем */
  .pin { width: 36px; height: 36px; padding: 0; border: 0; background: none; cursor: pointer; z-index: 1; }
  .pin.on { z-index: 2; }
  .dot { position: absolute; inset: 9px; border-radius: 50%; background: var(--copper-strong); border: 3px solid #fff; box-shadow: 0 2px 6px rgba(0, 0, 0, .3); transition: transform .2s, background .2s; }
  .pin:hover .dot { transform: scale(1.2); }
  .pin.on .dot { background: var(--pine); transform: scale(1.35); }
  .pin.on .dot::after { content: ''; position: absolute; inset: -9px; border-radius: 50%; border: 2px solid #fff; opacity: .9; }

  .tip { position: absolute; width: max-content; max-width: 240px; display: grid; gap: 4px; padding: 10px 12px; border-radius: 12px; background: var(--card); color: var(--ink-2); box-shadow: 0 8px 24px rgba(38, 40, 43, .18); font-size: 13px; line-height: 1.35; text-align: left;
    opacity: 0; pointer-events: none; transition: opacity .2s, translate .2s; }
  .tip b { color: var(--ink); font-size: 15px; display: flex; gap: 8px; justify-content: space-between; }
  .tip-v { color: var(--copper-strong); white-space: nowrap; }
  .pin.on .tip { opacity: 1; }
  .tip-t .tip { bottom: calc(100% + 4px); } .tip-b .tip { top: calc(100% + 4px); }
  .tip-c .tip { left: 50%; translate: -50% 0; } .tip-r .tip { left: 0; } .tip-l .tip { right: 0; }

  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .place { width: 100%; display: grid; grid-template-columns: 72px 1fr; gap: 12px; align-items: center; padding: 10px 14px; border-radius: var(--r-s); border: 1px solid transparent; background: none; font: inherit; color: inherit; text-align: left; cursor: pointer; transition: background .2s, border-color .2s; }
  .place:hover { background: var(--card); }
  .place.on { background: var(--card); border-color: var(--line); }
  .v { font-size: 24px; font-weight: 800; letter-spacing: -.04em; line-height: 1; white-space: nowrap; }
  .v small { font-size: 13px; letter-spacing: 0; margin-left: 3px; }
  .place.on .v { color: var(--copper-strong); }
  .v-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: var(--pine); margin-left: 4px; }
  .t strong { display: block; font-weight: 700; font-size: 15px; line-height: 1.3; }
  /* Пояснение на большом экране показывает подсказка на карте, а в списке оно остаётся для читалок */
  .note { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 980px) {
    .amap { grid-template-columns: 1fr; }
    /* На узкой карте подсказка закрыла бы полкадра, поэтому пояснение стоит в списке под выбранным местом */
    .tip { display: none; }
    .place.on .note { position: static; width: auto; height: auto; clip: auto; white-space: normal; display: block; margin-top: 2px; color: var(--ink-2); font-size: 14px; line-height: 1.4; }
    .home span { font-size: 11px; padding: 3px 6px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .route, .dim, .dot, .tip { transition: none; }
  }
</style>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-amap]')) {
    const controls = root.querySelectorAll<HTMLElement>('.pin, .place, .route');
    const select = (id: string) => {
      if (root.dataset.active === id) return;
      const pin = root.querySelector<HTMLElement>(`.pin[data-id="${id}"]`)!;
      root.dataset.active = id;
      root.style.setProperty('--x', `${pin.dataset.x}%`);
      root.style.setProperty('--y', `${pin.dataset.y}%`);
      for (const el of controls) {
        const on = el.dataset.id === id;
        el.classList.toggle('on', on);
        if (el.classList.contains('place')) el.setAttribute('aria-pressed', String(on));
      }
    };
    for (const el of root.querySelectorAll<HTMLElement>('.pin, .place')) {
      const id = el.dataset.id!;
      el.addEventListener('click', () => select(id));
      el.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') select(id); });
      el.addEventListener('focus', () => select(id));
    }
  }
</script>
