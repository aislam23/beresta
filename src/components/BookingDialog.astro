<dialog id="booking" aria-labelledby="booking-title" aria-describedby="booking-text">
  <div class="dlg" data-lead-box>
    <button type="button" class="x" data-close aria-label="Закрыть">×</button>
    <h3 id="booking-title">Бронь на 7 дней</h3>
    <p id="booking-text">Квартиру снимем с продажи. 15&nbsp;000&nbsp;₽ пойдут в счёт стоимости, а если передумаете, вернём их.</p>
    <div class="sum"><span data-booking-what></span><span>15&nbsp;000&nbsp;₽</span></div>
    <form class="lead-form light" data-kind="booking" novalidate>
      <div class="field">
        <label for="booking-name">Имя</label>
        <input id="booking-name" name="name" aria-required="true" aria-describedby="booking-name-err" placeholder="Как к вам обращаться" autocomplete="given-name">
        <p class="err" id="booking-name-err" data-error-for="name" hidden></p>
      </div>
      <div class="field">
        <label for="booking-phone">Телефон</label>
        <input id="booking-phone" name="phone" type="tel" inputmode="tel" aria-required="true" aria-describedby="booking-phone-err" placeholder="+7 900 000-00-00" autocomplete="tel">
        <p class="err" id="booking-phone-err" data-error-for="phone" hidden></p>
      </div>
      <div class="field">
        <label class="agree" for="booking-consent"><input type="checkbox" id="booking-consent" name="consent" aria-required="true" aria-describedby="booking-consent-err">Согласен на обработку персональных данных</label>
        <p class="err" id="booking-consent-err" data-error-for="consent" hidden></p>
      </div>
      <button class="btn btn-c" type="submit">Перейти к оплате брони</button>
    </form>
    <div class="ok" data-lead-success hidden>
      <h3 tabindex="-1" data-lead-success-title>Бронь оформлена</h3>
      <p>Менеджер свяжется, чтобы подобрать конкретную квартиру и этаж.</p>
      <p class="demo">Это учебный сайт: оплаты и бронирования нет.</p>
    </div>
  </div>
</dialog>
<script>
  import { initLeadForm, resetLeadForm } from '../lib/forms';

  const dlg = document.getElementById('booking') as HTMLDialogElement | null;
  const form = dlg?.querySelector<HTMLFormElement>('form');
  const what = dlg?.querySelector<HTMLElement>('[data-booking-what]');
  if (dlg && form && what) {
    let opener: HTMLElement | null = null;
    let flatType = '';
    initLeadForm(form, () => ({ flatType }));

    document.querySelectorAll<HTMLButtonElement>('button[data-book]').forEach((btn) => {
      btn.addEventListener('click', () => {
        opener = btn;
        flatType = btn.dataset.flat ?? '';
        what.textContent = btn.dataset.book ?? '';
        resetLeadForm(form);
        dlg.showModal();
      });
    });
    dlg.querySelector('[data-close]')?.addEventListener('click', () => dlg.close());
    // клик по фону: у dialog нет паддинга, поэтому target === dlg только вне .dlg.
    // Нажатие тоже должно быть на фоне: иначе выделение текста в поле с отпусканием
    // мыши снаружи даёт click по общему предку, то есть по dialog, и окно закрывается.
    let downOnBackdrop = false;
    dlg.addEventListener('pointerdown', (e) => { downOnBackdrop = e.target === dlg; });
    dlg.addEventListener('click', (e) => {
      if (downOnBackdrop && e.target === dlg) dlg.close();
      downOnBackdrop = false;
    });
    dlg.addEventListener('close', () => opener?.focus());
  }
</script>
<style>
  dialog { border: 0; border-radius: 24px; padding: 0; max-width: 480px; width: calc(100% - 32px); background: var(--card); color: var(--ink); }
  dialog::backdrop { background: rgba(38, 40, 43, .5); backdrop-filter: blur(3px); }
  .dlg { position: relative; padding: 28px; display: grid; gap: 14px; }
  .dlg h3 { font-size: 26px; letter-spacing: -.035em; }
  /* только текст окна: иначе правило перебьёт цвет ошибок .lead-form .err */
  .dlg > p { color: var(--ink-2); font-size: 15px; }
  /* 44×44 под палец; крестик стоит там же, где в прототипе */
  .dlg .x { position: absolute; right: 8px; top: 6px; width: 44px; height: 44px; border-radius: 12px; background: none; border: 0; font-size: 28px; line-height: 1; cursor: pointer; color: var(--ink-2); }
  .dlg .sum { display: flex; justify-content: space-between; gap: 12px; background: var(--copper-2); border-radius: 12px; padding: 14px 16px; font-weight: 700; }
  .dlg .ok { border-radius: 16px; padding: 20px; background: var(--pine-2); }
  .dlg .ok h3 { font-size: 22px; margin-bottom: 6px; }
  .dlg .ok p { color: var(--ink-2); font-size: 15px; }
  .dlg .ok .demo { font-size: 12px; margin-top: 8px; }
</style>
